[Unit]
Description=CampusCoder Next.js App
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/campuscoder
EnvironmentFile=/var/www/campuscoder/.env.local
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
User=ec2-user
Group=ec2-user

[Install]
WantedBy=multi-user.target
