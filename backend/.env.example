# Backend environment variables
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Azure Database for large objects (event images/videos, competition resources, notes, showcase)
AZURE_DB_CONNECTION_STRING=postgresql://user:password@your-azure-db.postgres.database.azure.com:5432/campuscoder
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
# Or use a service-level SAS URL instead of AZURE_STORAGE_CONNECTION_STRING:
# AZURE_STORAGE_SAS_URL=https://your_account.blob.core.windows.net/?sv=...

# CORS & CSRF allowed frontend origins
# In production, set FRONTEND_URL to your deployed frontend domain (e.g. https://your-domain.com or https://your-app.vercel.app).
# For preview deployments or multiple origins, specify comma-separated origins or wildcard patterns in CORS_ALLOWED_ORIGINS (e.g. https://your-domain.com,https://*.vercel.app).
FRONTEND_URL=http://localhost:3000
# CORS_ALLOWED_ORIGINS=https://your-domain.com,https://*.vercel.app
BACKEND_PORT=4000
