{
  "name": "campuscoder-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node ../scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint --ignore-pattern .next/**",
    "type-check": "tsc --noEmit",
    "test": "npm run lint && npm run type-check",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "framer-motion": "^12.40.0",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "1.17.0",
    "next": "15.5.23",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "lighthouse": "^12.6.1",
    "react-doctor": "^0.2.14",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
