# Supabase Configurations (replace with your actual project values)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Recommended current public key from Supabase Dashboard > Connect or Settings > API Keys.
# This key is bundled into the browser and must rely on RLS policies for data protection.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Legacy fallback if your project only shows the older anon JWT key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Email Configuration (Resend)
RESEND_API_KEY=re_your_api_key_here
ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase key for protected server actions such as RSVP throttling.
# Never expose this value to client components, public docs, screenshots, or GitHub.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Legacy fallback if your project only shows the older service_role JWT key.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
