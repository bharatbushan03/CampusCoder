# ============================================================
# Frontend (frontend/.env.local)
# The Next.js app talks to the backend only. Browsers hit /api/*
# on this app, which Next proxies to the backend.
# ============================================================
BACKEND_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Self-hosting runtime
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000

# ============================================================
# Backend (backend/.env)
# The backend is the only service with Supabase access.
# ============================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Email Configuration (Resend) — used by the backend only
RESEND_API_KEY=re_your_api_key_here
ADMIN_EMAIL=admin@example.com
FROM_EMAIL=CampusCoder <noreply@your-domain.com>

# CORS & CSRF origin for the backend
# In production, set FRONTEND_URL to your deployed frontend domain (e.g. https://your-domain.com or https://your-app.vercel.app).
# For preview deployments or multiple origins, specify comma-separated origins or wildcard patterns in CORS_ALLOWED_ORIGINS (e.g. https://your-domain.com,https://*.vercel.app).
FRONTEND_URL=http://localhost:3000
# CORS_ALLOWED_ORIGINS=https://your-domain.com,https://*.vercel.app
BACKEND_PORT=4000

# Google Drive folders are displayed through the embedded viewer.
# No Google Drive API key is required.
